{
  "name": "xuanling-yuanjitain",
  "private": true,
  "version": "3.0.0",
  "description": "玄灵界·元极天 — SillyTavern风格修仙文字RPG全栈应用",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "build": "tsc -b && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:all": "npm run build && npm run build:server",
    "start": "node server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup": "npm install && mkdir -p data/lorebooks data/presets data/chats",
    "launch": "npm run build:all && npm start"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dexie": "^4.0.8",
    "express": "^4.21.0",
    "happy-dom": "^20.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4"
  }
}
